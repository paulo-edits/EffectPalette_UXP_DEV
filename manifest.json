{
  "manifestVersion": 5,
  "id": "com.effectpalette.uxp",
  "name": "FX.palette",
  "version": "0.52.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "ws://localhost:58756"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "headlessSetVioletLabel",
      "label": {
        "default": "Set selected Project items to Violet"
      }
    }
  ]
}
