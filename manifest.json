  "name": "FX.palette UXP Diagnostics",
  "version": "0.5.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "effectPaletteDiagnostics",
