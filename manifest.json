{
  "manifestVersion": 5,
  "id": "com.pauloedits.effectpalette.uxp.poc",
  "name": "FX.palette UXP Diagnostics",
  "version": "0.29.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "clipboard": "readAndWrite",
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "effectPaletteDiagnostics",
      "label": {
        "default": "FX.palette Diagnostics"
      },
      "minimumSize": {
        "width": 280,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 480
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 520
      }
    },
    {
      "type": "command",
      "id": "headlessSetVioletLabel",
      "label": {
        "default": "Set selected Project items to Violet (headless test)"
      }
    }
  ]
}
