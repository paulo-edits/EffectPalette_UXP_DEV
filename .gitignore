__pycache__/
*.pyc

# Generated at runtime from the live plugin's catalog - regenerates on every connection.
companion/data/uxp_video_transitions.json
companion/data/uxp_favorites.json
companion/data/uxp_effects.json
companion/data/uxp_project_items.json
companion/data/uxp_presets.json

# Written by scripts/configure_premiere_shortcuts.ps1 - machine-specific run log.
companion/data/premiere_shortcut_configuration.log


# Premiere writes this preview-cache folder next to the bundled template .prproj.
assets/template_project/Adobe Premiere Pro Audio Previews/

# Build outputs - the packaged plugin (built once via UDT's own Package menu, not by any script
# here) and everything build_release.ps1 produces from it.
packaging/dist/*.ccx
release/
