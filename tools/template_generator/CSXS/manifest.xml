<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest ExtensionBundleId="com.fxpalette.templategenerator"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="FX.palette Template Generator (dev tool)"
                   Version="12.0">

  <ExtensionList>
    <Extension Id="com.fxpalette.templategenerator.panel" Version="1.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.fxpalette.templategenerator.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./generator.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>FX.palette Template Generator</Menu>
          <Geometry>
            <Size><Height>420</Height><Width>480</Width></Size>
            <MinSize><Height>320</Height><Width>420</Width></MinSize>
            <MaxSize><Height>1200</Height><Width>1000</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
